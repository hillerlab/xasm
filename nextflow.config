// XORF ORF calling (submodule) — per-step config ported from the xorf pipeline.
// Two instances share these process names: the first-pass wrapper (...:XORF_RUN:...)
// publishes under 09_polish/xorf/, the twopass retention re-run
// (...:XORF_RUN_ON_TWOPASS_RETENTIONS:...) under 09_polish/xorf_twopass_retentions/.
// NOTE: the xorf module processes live inside the XORF subworkflow, so qualified
// names carry a :XORF: segment between the wrapper and the process — DO NOT drop it.
// Selectors anchor on the wrapper name so the two trees never mix.
process {
    withName: /.*:XORF_RUN:XORF:(CONCAT|CONCAT_RAW)$/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf/00_concat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:XORF_RUN:XORF:RENAME_PREDICTIONS$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf/01_renamed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Rename CLI flags apply to both instances, including the _RAW variants
    withName: /.*:RENAME_PREDICTIONS(_RAW)?$/ {
        ext.args = {
            // Standard configuration!
            def args = [ ]

            if (params.xorf_rename_rebase) {
                args += "--rebase"
            }

            if (params.xorf_rename_append_orf_score) {
                args += "--append-orf-score"
            }

            if (params.xorf_rename_append_protein_name) {
                args += "--append-protein-name"
            }

            if (params.xorf_rename_custom_prefix) {
                args += "--custom-prefix ${params.xorf_rename_custom_prefix}"
            }

            return args.join(' ')
        }
    }

    withName: /.*:XORF_RUN:XORF:(CONCAT_RENAMED|CONCAT_RENAMED_RAW)$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf/02_merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:PREDICT/ {
        ext.min_score_max_predictions = params.xorf_predict_min_score_max_predictions
        ext.max_predictions = params.xorf_predict_max_predictions
        ext.threshold = params.xorf_predict_threshold
        ext.args = {
            def base_args = []

            if (params.xorf_predict_keep_raw) {
              base_args = base_args + ' --keep-raw'
            }

            if (base_args.size() > 0) {
              return base_args.join(' ')
            } else {
              return ''
            }
        }
    }

    withName: /.*:NETSTART/ {
        containerOptions = '--env HF_HUB_OFFLINE=1 --env TRANSFORMERS_OFFLINE=1 --env NETSTART2_ALLOW_HF_DOWNLOAD=0'
    }

    withName: /.*:BLAST/ {
        // --esm activates ESMFold2-Fast pLDDT scoring in orf-blast; the vendored
        // module additionally reads global params.esm, bridged from xorf_esm in
        // XORF_RUN. Upstream dropped the 2h cap for ESM runs (CPU ESMFold outgrows
        // it), so the limit follows the flag; scratch stays on unless ESM is on.
        ext.args = { params.xorf_esm ? '--esm' : '' }
        scratch  = { params.xorf_esm ? false : true }
        time     = { (params.xorf_esm ? 16.h : 2.h) * task.attempt }
    }

    // ESMFold2-Fast + ESMC-6B weights prefetch (only runs with --xorf_esm and no
    // local weights). Published so later runs can reuse it via xorf_esmfold_local_weights.
    withName: /.*:DOWNLOAD_ESMFOLD_WEIGHTS/ {
        time = 12.h
        publishDir = [
            path: { "${params.output_dir}/00_prepare/esmfold_weights" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:XORF_RUN:XORF:DETACH_DUPLICATES$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf/03_duplicates" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:XORF_RUN:XORF:STRIP_TRUNCATIONS$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf/04_results" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── Twopass retention re-run — mirrored subtree under 09_polish/xorf_twopass_retentions
    withName: /.*:XORF_RUN_ON_TWOPASS_RETENTIONS:XORF:(CONCAT|CONCAT_RAW)$/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf_twopass_retentions/00_concat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:XORF_RUN_ON_TWOPASS_RETENTIONS:XORF:RENAME_PREDICTIONS$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf_twopass_retentions/01_renamed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:XORF_RUN_ON_TWOPASS_RETENTIONS:XORF:(CONCAT_RENAMED|CONCAT_RENAMED_RAW)$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf_twopass_retentions/02_merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:XORF_RUN_ON_TWOPASS_RETENTIONS:XORF:DETACH_DUPLICATES$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf_twopass_retentions/03_duplicates" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:XORF_RUN_ON_TWOPASS_RETENTIONS:XORF:STRIP_TRUNCATIONS$/ {
        publishDir = [
            path: { "${params.output_dir}/09_polish/xorf_twopass_retentions/04_results" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

process {
    withName: /.*:SORT_BED_NMD$/ {
        publishDir = [
            path: { "${params.output_dir}/10_final/nmd" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*.sorted.bed'
