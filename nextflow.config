}

process {
    withName: '.*:BEDTOBIGBED_HQ|.*:BEDTOBIGBED_FUSIONS|.*:BEDTOBIGBED_ARTIFACTS|.*:BEDTOBIGBED_WEAK_RTS|.*:BEDTOBIGBED_STRONG_RTS|.*:BEDTOBIGBED_RETENTION[S]?|.*:BEDTOBIGBED_TRUNCATIONS|.*:BEDTOBIGBED_SCRAPS' {
        publishDir = [
            path: { "${params.output_dir}/11_bbs" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*.bb'
        ]
    }
}

process {
    withName: '.*:FROM_BIGBED:.*' {
         publishDir = [
            path: { "${params.output_dir}/11_bbs" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*.bb'
        ]         
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXECUTOR/PROFILES CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

profiles {
     local {
        process.executor = 'local'
     }

     slurm {
        process {
            executor        = 'slurm'
            queue           = 'batch'
            scratch         = true
            stageInMode     = 'symlink'
            stageOutMode    = 'rsync'
            queue          = { task.time <= 24.h ? 'batch' : 'long' }
            clusterOptions = '--signal=USR2@180 --export=ALL,SLURM_SKIP_EPILOG=1'

            withName: '.*:FASTP|.*:BQC|.*:BQTOOLS_ENCODE.*|.*:BQTOOLS_DECODE|.*:DEACON_FILTER|.*:STAR_ALIGN_1PASS|.*:STAR_ALIGN_2PASS|.*:RUSTAR_ALIGN_1PASS|.*:RUSTAR_ALIGN_2PASS|.*:SAMTOOLS_INDEX|.*:BEDGRAPHTOBIGWIG|.*:ALETSCH' {
                array = 50
            }
        }
        executor {
            queueSize         = 10000
            killBatchSize     = 1000000
            pollInterval      = '10 s'      // internal task-monitor tick (no SLURM RPC)
            queueStatInterval = '1 min'     // squeue cadence — halves RPC pressure
            submitRateLimit   = '5000/30sec' // max concurrent submits per node
            exitReadTimeout   = '5 min'    // tolerate slow .exitcode propagation; lets retry fire on ghosts
        }
    }   

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }

    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
        docker.pullTimeout      = '20 min'
    }

    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        singularity.pullTimeout = '20 min'
    }

    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        podman.pullTimeout      = '20 min'
    }

    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.pullTimeout   = '20 min'
    }

    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }

    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }

    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }

     'test-polish' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results"
        params.genome      = "${projectDir}/assets/test/test_data/test_genome.fa"
        params.annotation  = "${projectDir}/assets/test/test_data/test_annotation.gtf"
        params.from        = 'polish'
        params.polish_path = "${projectDir}/assets/test/test_data/test_metassembly.gtf"

        params.prefix = "test"

        params.skip_bb_conversion = true
     }

     test {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/aletsch-beaver"
        params.input_dir   = "${projectDir}/assets/test/test_data/e2e/reads"
        params.genome      = "${projectDir}/assets/test/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/assets/test/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/assets/test/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/assets/test/test_data/e2e/repeats.bed"
        params.prefix      = "test"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.star_ignore_gtf_for_index = false
        params.star_ignore_gtf_for_mapping = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.assembler = "aletsch"
        params.metassembler = "beaver"
        params.aletsch_fallback_insert_size = 180
        params.do_twopass_polish = true
        params.xorf_call_orfs = true
        params.xorf_custom_database = "${projectDir}/assets/test/test_data/e2e/xorf_db.dmnd"
        params.xorf_selenocysteine_sites = "${projectDir}/assets/test/test_data/e2e/selenocysteine_sites.bed"
        params.xorf_chunk_size = 2
        params.skip_bb_conversion = true
        // The synthetic test loci start at coord ~500; xorf's default 1000 bp
        // chunking flank underflows and orf-chunk skips every record (--ignore-errors).
        // Shrink the flank for the whole ORF chain (chunker sets the slice window;
        // tai/samba/blast must not ask for more than the slice covers).
        process {
            withName: /.*:CHUNKER|.*:UNMASKED_CHUNKER|.*:TRANSLATION|.*:RNASAMBA|.*:BLAST/ {
                ext.upstream = 100
                ext.downstream = 100
            }
        }
     }

     'test-sb' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/stringtie-beaver"
        params.input_dir   = "${projectDir}/assets/test/test_data/e2e/reads"
        params.genome      = "${projectDir}/assets/test/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/assets/test/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/assets/test/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/assets/test/test_data/e2e/repeats.bed"
        params.prefix      = "test_sb"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.star_ignore_gtf_for_index = false
        params.star_ignore_gtf_for_mapping = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.assembler = "stringtie3"
        params.metassembler = "beaver"
        params.skip_bb_conversion = true
     }

     'test-tm' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/transmeta"
        params.input_dir   = "${projectDir}/assets/test/test_data/e2e/reads"
        params.genome      = "${projectDir}/assets/test/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/assets/test/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/assets/test/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/assets/test/test_data/e2e/repeats.bed"
        params.prefix      = "test_tm"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.star_ignore_gtf_for_index = false
        params.star_ignore_gtf_for_mapping = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.metassembler = "transmeta"
        params.transmeta_use_annotation = false
        params.skip_bb_conversion = true
     }

     'test-rustar' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/rustar-beaver"
        params.input_dir   = "${projectDir}/assets/test/test_data/e2e/reads"
        params.genome      = "${projectDir}/assets/test/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/assets/test/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/assets/test/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/assets/test/test_data/e2e/repeats.bed"
        params.prefix      = "test"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.assembler = "aletsch"
        params.metassembler = "beaver"
        params.skip_bb_conversion = true

        params.aligner = "ruSTAR"
        params.star_make_coverage = false
        params.bqtools_encode_fastqs = true
        // Synthetic fixture looks like pooled libraries; bqc --auto-detect aborts.
        params.bqc_adapter_auto_detect = false
     }

     'test-bqc-star' {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]
        params.output_dir  = "${projectDir}/test_results/bqc-star"
        params.input_dir   = "${projectDir}/assets/test/test_data/e2e/reads"
        params.genome      = "${projectDir}/assets/test/test_data/e2e/genome.2bit"
        params.annotation  = "${projectDir}/assets/test/test_data/e2e/annotation.gtf"
        params.splice_scores_dir = "${projectDir}/assets/test/test_data/e2e/spliceai"
        params.repeats     = "${projectDir}/assets/test/test_data/e2e/repeats.bed"
        params.prefix      = "test"

        params.fastp_min_trimmed_reads = 100
        params.fastp_deduplicate_reads = false
        params.deacon_make_single_index = true
        params.deacon_single_index_use_background = false
        params.star_ignore_gtf_for_index = false
        params.star_ignore_gtf_for_mapping = false
        params.junction_min_read_coverage = 2
        params.junction_min_junction_length = 20
        params.assembly_by_chr = true
        params.assembly_exclude_chromosomes = ['chrTestFlush']
        params.assembler = "aletsch"
        params.metassembler = "beaver"
        params.aletsch_fallback_insert_size = 180
        params.skip_bb_conversion = true

        params.aligner = "STAR"
        params.bqtools_encode_fastqs = true
        params.xorf_call_orfs = false
        // Synthetic fixture looks like pooled libraries; bqc --auto-detect aborts.
        params.bqc_adapter_auto_detect = false
     }
}


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PROCESS LABELS;
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = {
        (task.exitStatus in ((130..145) + 104 + 175)) ||
        (task.exitStatus in [null, Integer.MAX_VALUE])   ? 'retry' : 'finish'
    }
    maxRetries    = 5
    maxErrors     = '-1'

    // Single processes
    withLabel: process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // Low memory processes
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:custom_process_low {
        cpus   = { 4     * task.attempt }
        memory = { 10.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // Medium memory processes
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:custom_process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // High memory processes
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    // Long running processes
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
        queue  = 'long'
    }
    withLabel:process_long_high {
        cpus   = { 24 }
        memory = { 72.GB * task.attempt }
        time   = { 96.h  * task.attempt }
        queue  = 'long'
    }

    // Strategies
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // GPU
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGISTRY CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ENVIRONMENT CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BASH OPTIONS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set bash options
process {
  shell = [
      "bash",
      "-C",         // No clobber - prevent output redirection from overwriting files.
      "-e",         // Exit if a tool returns a non-zero status/exit code
      "-u",         // Treat unset variables and parameters as an error
      "-o",         // Returns the status of the last command to exit..
      "pipefail"    //   ..with a non-zero status or zero if all successfully execute
  ]
}


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REPORT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
