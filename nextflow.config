/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    xasm — single unified Nextflow configuration

    Infrastructure configuration — do not edit for normal runs.
    Scientific parameters (genome paths, alignment settings) live in params.json.

    Usage:
      nextflow run main.nf -params-file params.json -profile apptainer,slurm

    This file contains:
      1. params {}          — output dir, resource ceilings, nf-core boilerplate
      2. Process resources  — compute tiers (cpus, memory, time) via withLabel
      3. Per-step config    — container, conda, publishDir via withName
      4. Profiles           — executor and environment selection
      5. Reporting          — timeline, trace, DAG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

cleanup = false
workDir = 'work'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MANIFEST
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/


manifest {
    name            = 'hillerlab/xasm'
    author          = 'Alejandro Gonzales-Irribarren, Michael Hiller'
    homePage        = 'https://github.com/hillerlab/xasm'
    description     = "meta-assemble bulk RNA-seq datasets at scale"
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24.10.5'
    version         = '0.1.12'
}

validation {
    help {
        enabled = true
        command = "nextflow run main.nf -profile <docker/singularity/.../institute>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    DEFAULT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params, used in configs
params {

    // Main input options
    input_dir         =  ''         // input directory containing fastq files
    output_dir        =  null       // output directory
    genome            =  ''         // path to genome file (fasta/2bit)
    annotation        =  ''         // path to annotation file (gtf/gff/bed) [defines STAR + iso-orphan inputs]
    splice_scores_dir = null     // path to splicing scores dir
    repeats           = null               // path to repeats.{bed}
    prefix            = null               // prefix for output files
    from              = null               // checkpoint [options: polish, bigbed]
    polish_path       = null               // metassembly used by the polish checkpoint
    all_bed_path      = null               // BED directory used by the bigbed checkpoint

    // ANNEVO annotation [optional] — second reference annotation for iso-orphan,
    // iso-fusion and iso-classify, merged with --annotation by POLISH
    annevo_annotation  = null    // precomputed ANNEVO annotation (.bed/.gtf/.gff/.gff3)
    annevo_predict     = false   // run ANNEVO on the genome [ignored if annevo_annotation is set]
    annevo_lineage     = null    // ANNEVO lineage [Mammalia, Insecta, Aves, Actinopteri, Magnoliopsida, Fungi]
    annevo_scatter     = 'chromosome' // ANNEVO scatter mode [none, chromosome, weighted]
    annevo_bins        = 8       // bins for --annevo_scatter weighted
    annevo_overlap_pred = null   // allow overlapping gene predictions [default: lineage-specific]

    // TIBERIUS annotation [optional] — like ANNEVO, a second reference annotation
    // for iso-orphan, iso-fusion and iso-classify, merged with --annotation by POLISH.
    // Unlike ANNEVO, --tiberius_annotation and --tiberius_predict may be combined.
    tiberius_annotation  = null    // precomputed TIBERIUS annotation (.bed/.gtf/.gff/.gff3)
    tiberius_predict     = false   // run TIBERIUS on the genome
    tiberius_model_cfg   = null    // TIBERIUS model alias from /opt/tiberius/models.tsv [required with --tiberius_predict]
    tiberius_scatter     = 'chromosome' // TIBERIUS scatter mode [none, chromosome, weighted]
    tiberius_bins        = 8       // bins for --tiberius_scatter weighted
    tiberius_batch_size  = null    // TIBERIUS --batch_size
    tiberius_seq_len     = null    // TIBERIUS --seq_len
    tiberius_protseq     = false   // also emit TIBERIUS protein FASTA
    tiberius_codingseq   = false   // also emit TIBERIUS coding-sequence FASTA
    tiberius_extra_args  = ''      // extra args passed through to tiberius.py

    env =  null       // path to environment dir [optional]

    // Linting
    fq_skip_linting_at_start         = false                      // skip linting
    fq_skip_linting_after_trimming   = true                      // skip linting after trimming
    fq_skip_linting_after_deacon     = true                      // skip linting after decontamination
    fq_extra_args                    = '--disable-validator P001' // forces same name for pair

    // Trimming
    fastp_allow_gap_overlap_trimming    = true  // --allow_gap_overlap_trimming
    fastp_allow_correction              = true  // --correction
    fastp_discard_trimmed_pass          = false // --discard_trimmed_pass
    fastp_save_trimmed_fail             = false // --save_trimmed_fail
    fastp_save_merged                   = false // --save_merged
    fastp_min_trimmed_reads             = 10000 // --min_trimmed_reads
    fastp_deduplicate_reads             = true  // --deduplicate_reads
    fastp_deduplication_accuracy        = 3     // --deduplication_accuracy

    // Decontamination
    deacon_index_path                           = null   // path to deacon index
    deacon_download_index                       = false  // download deacon index
    deacon_make_single_index                    = false  // make single deacon index
    deacon_single_index_use_background          = false  // use background [FDA-ARGOS + RefSeq viral] for single index
    deacon_multi_index_additional_genome_paths  = null   // additional genome paths
    deacon_keep_fastp_fastq                     = false  // keep fastp fastq
    deacon_entropy_threshold                    = 0.5   // deacon entropy threshold -> note background is always 0.5 [0.0 available on zenodo too]
    deacon_background_download_url              = 'https://zenodo.org/records/17511655/files/argos988_rsvirus17900.k31w15e5.idx?download=1'   // deacon background download url

    // CBQ / BINSEQ [optional]
    bqtools_encode_fastqs            = false // encode fastq inputs to .cbq up front; QC then runs via bqc (STAR decodes after deacon)
    bqtools_encode_before_alignment  = false // keep fastp+deacon on fastq and encode to .cbq only for the aligner (ruSTAR only)
    bqc_min_length                   = 15    // --min-length: reject reads shorter than this
    bqc_quality_tail                 = 15    // --quality-tail: drop 3' bases until the trailing window reaches this Phred
    bqc_poly_g                       = true  // --poly-g: trim G-rich 3' tails
    bqc_max_n                        = null  // --max-n: reject reads with more than N ambiguous bases
    bqc_adapter_auto_detect          = true  // --auto-detect: infer adapters. WARN: aborts the task when detection is ambiguous (e.g. pooled libraries)
    bqc_adapter_r1                   = null  // --adapter-r1: explicit R1 adapter sequence
    bqc_adapter_r2                   = null  // --adapter-r2: explicit R2 adapter sequence
    bqc_extra_args                   = null  // extra arguments passed verbatim to `bqc workflow`

    // Strandedness inference [CBQ at the trim point only] — bqc sniff strand
    // against a reference CDS transcriptome. fastp-only and encode_before_alignment
    // runs keep the hardcoded 'unstranded'.
    infer_strandedness               = true   // infer per-sample strandedness before trimming
    strand_transcriptome             = null   // prebuilt transcriptome FASTA (skips XLOCI CDS extraction)
    strand_salmon_index              = null   // prebuilt Salmon 2.x index dir (skips extraction + index build)

    // Alignment
    aligner                                   = "STAR"     // aligner [options: STAR, ruSTAR]; ruSTAR reads fastq and cbq; STAR reads fastq (CBQ is decoded after deacon)
    star_index_path                           = null       // path to STAR index
    star_ignore_gtf_for_index                 = false      // ignores gtf for index
    star_ignore_gtf_for_mapping               = true       // ignores gtf for mapping
    star_seq_center                           = "custom"   // sequencing center
    star_seq_platform                         = "illumina" // sequencing platform
    star_seq_library                          = "default"  // sequencing library
    star_machine_type                         = "default"  // sequencing machine
    star_min_mapped_reads                     = 5          // min mapped reads
    star_extra_align_args                     = null       // extra arguments for STAR
    star_save_unaligned                       = false      // saves unaligned reads
    star_keep_first_pass_bam                  = false      // keep first pass bam
    star_delete_fastq_after_alignment         = true       // delete fastq after second pass
    star_twopass_junctions_file               = null       // path to pre-curated junction file [STAR sjdb 4-col] -> skips first pass
    star_make_coverage                        = true       // make coverage [bedgraph -> bigwig -> wig]

    // Junctions
    junction_min_read_coverage     = 2          // min read support for junction
    junction_min_junction_length   = 50         // min junction length

    // Coverage
    bigtools_keep_bedgraph         = false      // keep bedgraph
    wigtools_keep_bigwig           = false      // keep bigwig
    wigtobigwig_keep_wig           = false      // keep wig

    // Assembly
    skip_assembly                     = false      // skip assembly
    assembly_by_chr                   = true       // split bams per-chr and assemble per-chr [bamsplit chrom + per-chr beaver]
    assembly_exclude_chromosomes      = []         // optional chromosomes to retain in alignment but omit from assembly fan-out
    transmeta_use_annotation          = true       // pass the reference GTF to TransMeta's annotation-guided merge
    assembler                        = "aletsch"  // local assembler [options: aletsch, stringtie3]
    metassembler                     = "beaver"   // meta-assembler [options: beaver, transmeta]
    aletsch_keep_bam                  = false      // keep bam
    aletsch_fallback_insert_size      = null       // replace a zero profiled insert-size mean when explicitly provided
    aletsch_fallback_insert_std       = 10         // standard deviation paired with the optional fallback mean
    beaver_keep_aletsch_gtf           = false      // keep aletsch gtf

    // Stringtie3 options
    stringtie3_enable_nascent_assembly = false     // stringtie3: run de novo assembly of nascent RNA [-N]
    stringtie3_include_nascent_rna     = false     // stringtie3: include nascent RNA in the assembly [--nasc]

    // xloci options [intron]
    xloci_upstream_flank = 100    // upstream flank [ default: 100 ]
    xloci_downstream_flank = 100  // downstream flank [ default: 100 ]

    // Isotools intron classifier options
    isotools_classify_spliceai_min_ss_signal     = 0.02 // min signal to be considered significant [ default: 0.02 ]
    isotools_classify_rt_frequency_threshold     = 0.5  // frequency threshold to be considered [ default: 0.5 ]
    isotools_classify_intron_frequency_threshold = 0.5  // frequency threshold to be considered [ default: 0.5 ]
    isotools_classify_maxent_min_ss_signal       = 1.5  // frequency threshold to be considered [ default: 0.5 ]
    do_twopass_polish                            = false // review first-pass retention discards and rescue UTR retentions

    // ORF calling (XORF)
    xorf_call_orfs                          = true   // run XORF ORF calling on first-pass HQ transcripts
    xorf_esm                                = false  // add CPU ESMFold2-Fast pLDDT scores to BLAST
    xorf_esmfold_local_weights              = null   // local Hugging Face hub cache with ESMFold2-Fast + ESMC-6B; skips download
    xorf_selenocysteine_sites               = null   // custom selenocysteine sites file
    xorf_custom_database                    = null    // custom protein db: .dmnd/.dmnd.gz replaces default; .fa/.fasta/.fa.gz appended to SwissProt and reindexed
    xorf_chunk_size                         = 20      // chunk size for XORF parallel processing
    xorf_skip_netstart                      = true    // skip netstart
    xorf_predict_min_score_max_predictions  = 0.50    // min score for ORF predictions
    xorf_predict_max_predictions            = 3       // max ORF predictions per region
    xorf_predict_threshold                  = 0.03    // prediction threshold
    xorf_predict_keep_raw                   = false   // keep raw predictions
    xorf_do_polishing                       = true    // polish ORFs (duplicates, truncations)
    xorf_skip_joined_concat                 = false   // skip joined concatenation of chunks
    xorf_rename_deactivate                  = false   // disable ORF renaming
    xorf_rename_rebase                      = false   // rebase names to short hashes
    xorf_rename_append_orf_score            = true    // append ORF score to names
    xorf_rename_append_protein_name         = true    // append protein name to names
    xorf_rename_custom_prefix               = null    // custom prefix for ORF names
    xorf_samba_weights                      = 'https://github.com/apcamargo/RNAsamba/raw/refs/heads/master/data/full_length_weights.hdf5'
    xorf_samba_local_weights                = null    // local RNAsamba weights file

    // Bigbed options
    autosql = null
    skip_bb_conversion = false

    // Mailing options
    sent_email                   = false             // decides to send email or not
    smtp_server                  = 'smtp.gmail.com'  // smtp server [default: smtp.gmail.com]
    smtp_port                    = 465               // smtp port [default: 465]
    smtp_user                    = null              // smtp user [sender]
    smtp_password                = null              // smtp password [sender]
    smtp_security                = 'ssl'             // smtp security [none, tls, ssl]
    email_to                     = null              // recipient email address
    email_on_fail                = null              // email_on_fail
    plaintext_email              = false             // plaintext_email
    interactive                  = false             // interactive
    use_mailx                    = false             // use_mailx instead smtp

    // Boilerplate options
    publish_dir_mode             = 'copy'   // publish_dir_mode
    publish_all                  = false    // publish all
    help                         = false    // help
    help_full                    = false    // help_full
    show_hidden                  = false    // show_hidden
    version                      = false    // version
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')  // Config options

    // Config options
    config_profile_name        = null
    config_profile_description = null

}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXTENDING PROCESS DEFINITIONS AND ARGUMENTS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Add params to fastp process
process {
    withName: /.*:FASTP/ {
        ext.args = { [
            params.fastp_allow_gap_overlap_trimming ? '--allow_gap_overlap_trimming' : '',
            params.fastp_allow_correction ? '--correction' : '',
            params.fastp_deduplicate_reads ? '--dedup' : '',
            params.fastp_deduplication_accuracy ? "--dup_calc_accuracy ${params.fastp_deduplication_accuracy}" : ''
        ].findAll { it != '' }.join(' ').trim() }
        ext.prefix = { "${meta.id}" }
    }
}

// Add params to wget deacon index process
process {
    withName: /.*:WGET_DEACON_INDEX/ {
        ext.suffix = { "idx" }
        publishDir = [
            path: { "${params.output_dir}/00_prepare/wget/deacon_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:DEACON_FILTER/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.output_dir}/01_deacon_filter" },
             mode: 'symlink', // WARN: change to params.publish_dir_mode if fastqs needed
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:DEACON_DIFF/ {
        ext.prefix = { "${meta.id}_filtered" }
        publishDir = [
             path: { "${params.output_dir}/00_prepare/deacon_index" },
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:WGET_BACKGROUND/ {
        ext.when = true
        ext.suffix = { "idx" }
    }

    withName: /.*:DEACON_INDEX/ {
        ext.when = true
        ext.args = {
          def args = """
            --entropy-threshold ${params.deacon_entropy_threshold}
          """ .trim()

          return args
        }
    }
}

// Params for STAR processes
process {
    // Add params to STAR process
    withName: /.*:STAR_ALIGN_1PASS/ {
        ext.when = true
        ext.args   = {
            def extra_args = params.star_extra_align_args ?: ''
            // Standard STAR-2pass pipeline configuration!
            def base_args = """
                --readFilesCommand zcat
            """.trim()

            return base_args + " " + extra_args
        }
        ext.prefix = { "${meta.id}" }
    }

    // Add params to STAR 2pass process
    withName: /.*:STAR_ALIGN_2PASS/ {
        ext.when = true
        ext.args   = {
            def extra_args = params.star_extra_align_args ?: ''
            // Standard STAR-2pass pipeline configuration!
            def base_args = [
                '--outSAMtype BAM SortedByCoordinate',
                '--outSAMattributes NH HI AS nM NM MD ch',
                '--readFilesCommand zcat',
                '--outSAMstrandField intronMotif',
                '--outSAMunmapped None',
                '--outFilterMultimapNmax 20',
                '--alignSJDBoverhangMin 1',
                '--peOverlapNbasesMin 5',
                '--outBAMcompression 10',
                '--limitSjdbInsertNsj 2500000',
            ]

            if (params.star_make_coverage) {
              base_args = base_args + ' --outWigType bedGraph --outWigStrand Unstranded --outWigNorm RPM'
            }

            return (base_args + extra_args.split(' ')).join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/03_star_2pass" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Add params to ruSTAR 1pass process
    withName: /.*:RUSTAR_ALIGN_1PASS/ {
        ext.when = true
        ext.args   = {
            // NOTE: --readFilesCommand is NOT set here. RUSTAR_ALIGN adds `zcat` itself
            // only when the staged file is FASTQ, since a .cbq is decoded in-process.
            return (params.star_extra_align_args ?: '').trim()
        }
        ext.prefix = { "${meta.id}" }
    }

    // Add params to ruSTAR 2pass process
    withName: /.*:RUSTAR_ALIGN_2PASS/ {
        ext.when = true
        ext.args   = {
            def extra_args = params.star_extra_align_args ?: ''
            // Mirrors the STAR 2pass configuration, with two deliberate omissions:
            //   --readFilesCommand   RUSTAR_ALIGN adds `zcat` itself, and only for FASTQ
            //   --limitSjdbInsertNsj not implemented by rustar-aligner 0.2.0 (it is a
            //                        STAR-specific sjdb insertion cap) -- passing it aborts
            // Every other flag below is accepted by rustar-aligner.
            def base_args = [
                '--outSAMtype BAM SortedByCoordinate',
                // 'ch' (STAR's chimeric tag) is dropped: rustar-aligner accepts only
                // Standard/All/None or NH HI AS NM nM MD jM jI XS RG vW vA vG.
                '--outSAMattributes NH HI AS nM NM MD',
                '--outSAMstrandField intronMotif',
                '--outSAMunmapped None',
                '--outFilterMultimapNmax 20',
                '--alignSJDBoverhangMin 1',
                '--peOverlapNbasesMin 5',
                '--outBAMcompression 10',
            ]

            // No coverage args here: rustar-aligner rejects `--outWigStrand Unstranded`
            // and only emits Stranded (str1 + str2), which is not what COVERAGE consumes.
            // validateRun() blocks aligner=ruSTAR together with star_make_coverage.

            // NOTE: guarded, unlike the STAR block above. `''.split(' ')` yields a
            // one-element array that Groovy appends as a single item, emitting a literal
            // "[]" token. STAR ignores it; rustar-aligner aborts on it.
            return (base_args + (extra_args ? extra_args.split(' ') as List : [])).join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/03_star_2pass" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ruSTAR delegates BAM indexing here (no samtools in the aligner image)
    withName: /.*:SAMTOOLS_INDEX/ {
        ext.prefix = { "${meta.id}" }
    }

    withName: /.*:BQTOOLS_ENCODE_INPUT/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/00_prepare/cbq" },
            mode: 'symlink', // WARN: change to params.publish_dir_mode if the .cbq files are needed
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // No publishDir: transient, and it deletes its own fastq input
    withName: /.*:BQTOOLS_ENCODE_ALIGN/ {
        ext.prefix = { "${meta.id}" }
    }

    // No publishDir: transient, and it deletes its own cbq input
    withName: /.*:BQTOOLS_DECODE/ {
        ext.prefix = { "${meta.id}" }
    }

    withName: /.*:BQC/ {
        // NOTE: `bqc workflow` aborts when no operation is configured, so --min-length
        // is always emitted to keep this list non-empty.
        ext.args = {
            [
                "--min-length ${params.bqc_min_length}",
                params.bqc_quality_tail      ? "--quality-tail ${params.bqc_quality_tail}" : '',
                params.bqc_poly_g            ? '--poly-g' : '',
                params.bqc_max_n != null     ? "--max-n ${params.bqc_max_n}" : '',
                params.bqc_adapter_auto_detect ? '--auto-detect' : '',
                params.bqc_adapter_r1        ? "--adapter-r1 ${params.bqc_adapter_r1}" : '',
                params.bqc_adapter_r2        ? "--adapter-r2 ${params.bqc_adapter_r2}" : '',
                params.bqc_extra_args        ?: ''
            ].findAll { it != '' }.join(' ').trim()
        }
        ext.prefix = { "${meta.id}" }
    }

    // Strand inference support: reference CDS transcriptome -> reusable Salmon
    // index -> per-sample bqc sniff strand reports. All three publish under
    // 00_prepare/strand so the index can be reused via --strand_salmon_index.
    withName: /.*:XLOCI_EXTRACT_CDS/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/00_prepare/strand" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:BQC_SNIFF_INDEX/ {
        publishDir = [
            path: { "${params.output_dir}/00_prepare/strand" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:BQC_SNIFF_STRAND/ {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.output_dir}/00_prepare/strand" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Add params to STAR genome generate process [will publish index on default]
    withName: /.*:STAR_GENOMEGENERATE/ {
        ext.when = true
        publishDir = [
            path: { "${params.output_dir}/02_star_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}


// Add params to MultiQC process
process {
    withName: /.*:MULTIQC|MULTIQC/ {
        ext.args = { "--flat" }
        publishDir = [
            path: { "${params.output_dir}/0X_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Add params to Stringtie3 process
process {
    withName: /.*:STRINGTIE3/ {
        ext.args = {
          def args = []

          if (params.stringtie3_enable_nascent_assembly) {
            args += "-N"
          } else if (params.stringtie3_include_nascent_rna) {
            args += "--nasc"
          }

          return args.join(' ')
        }
    }
}

// Overwriting publish mode for beaver/transmeta
process {
    withName: /.*:BEAVER/ {
        publishDir = [
            path: { "${params.output_dir}/06_beaver" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { params.assembly_by_chr ? (params.prefix ? "${params.prefix}_${meta.chr}" : meta.chr) : params.prefix }
    }

    withName: /.*:TRANSMETA/ {
        publishDir = [
            path: { "${params.output_dir}/06_transmeta" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { params.assembly_by_chr ? (params.prefix ? "${params.prefix}_${meta.chr}" : meta.chr) : params.prefix }
    }
}

// Overwriting publish mode for novel junctions
process {
    withName: /.*:JOIN_JUNCTIONS/ {
        publishDir = [
            path: { "${params.output_dir}/04_junctions" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Ignoreing errors for bedgraphtobigwig
process {
    withName: /.*:BEDGRAPHTOBIGWIG/ {
        errorStrategy = 'ignore'
    }
}

// Overwriting publish mode for wigtobigwig
process {
    withName: /.*:WIGTOBIGWIG/ {
        publishDir = [
            path: { "${params.output_dir}/05_coverage" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Overwriting publish mode for cleaning
process {
    withName: /.*:GTF_REMOVE_DIRT/ {
        publishDir = [
            path: { "${params.output_dir}/07_remove_dirt" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Overwriting publish mode for gxf2bed
process {
    withName: /.*:GXF2BED/ {
        publishDir = [
            path: { "${params.output_dir}/08_gxf2bed" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// ANNEVO annotation [optional]
process {
    // Regex selectors are full-match, so the `.*:GXF2BED` rule above does NOT cover
    // the aliased instance: without this the ANNEVO BED stays in the work dir.
    withName: /.*:GXF2BED_ANNEVO/ {
        publishDir = [
            path: { "${params.output_dir}/08_annevo" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // The gathered GFF3 is the single ANNEVO output worth keeping; the per-chunk .h5
    // predictions are large and only feed ANNEVO_DECODING.
    withName: /.*:ANNEVO_GATHER/ {
        publishDir = [
            path: { "${params.output_dir}/08_annevo" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: '*.annevo.gff3'
        ]
    }

    // ANNEVO's HMM (viterbi) is numba `@njit(cache=True)`, and both prediction and
    // decoding hit it. numba refuses to build a cache unless the source dir
    // (/opt/annevo/src) is writable, which it is not when containers run as the host
    // user (`-u $(id -u):$(id -g)`, the docker profile default) — the task dies with
    // "no locator available for file '/opt/annevo/src/HMM.py'". NUMBA_CACHE_DIR does
    // not help; a writable __pycache__ does.
    // ponytail: mount instead of `-u root` (keeps outputs host-owned) and use the
    // per-task work dir instead of a shared path (no races between chunks).
    // NOTE: mount the existing task work dir, not a subdirectory — docker creates a
    // missing mount source as root-owned, which is just as unwritable.
    withName: /.*:ANNEVO_(PREDICTION|DECODING)/ {
        containerOptions = {
            def mount = "${task.workDir}:/opt/annevo/src/__pycache__"
            workflow.containerEngine in ['docker', 'podman'] ? "-v ${mount}" : "-B ${mount}"
        }

        // Whole-genome inference outruns the process_high default (16h); on SLURM the
        // queue closure routes this to `long`. CPU fallback (no gpu profile) is slower
        // still — raise here if real runs keep hitting the wall.
        time = { 48.h * task.attempt }
    }
}

// TIBERIUS annotation [optional]
process {
    // Regex selectors are full-match, so the `.*:GXF2BED` rule above does NOT cover
    // the aliased instances: without this the TIBERIUS BEDs stay in the work dir.
    // Both aliases (precomputed-file and prediction branches) publish here.
    withName: /.*:GXF2BED_TIBERIUS.*/ {
        publishDir = [
            path: { "${params.output_dir}/08_tiberius" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // The merged GTF/GFF3 (+ optional protein/CDS FASTAs) is the TIBERIUS output
    // worth keeping; the per-chunk GTFs only feed TIBERIUS_MERGE.
    withName: /.*:TIBERIUS_MERGE/ {
        publishDir = [
            path: { "${params.output_dir}/08_tiberius" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /.*:TIBERIUS_PREDICT/ {
        // Unlike ANNEVO (which always gathers), TIBERIUS scatter `none` skips
        // TIBERIUS_MERGE, so the final GFF3/protein/CDS FASTAs only exist here.
        // Scattered chunks emit GTF only, which is deliberately dropped (the merged
        // GTF comes from TIBERIUS_MERGE); the BED converted from any mode's GTF is
        // published via GXF2BED_TIBERIUS_PRED above.
        publishDir = [
            path: { "${params.output_dir}/08_tiberius" },
            mode: 'copy',
            saveAs: { filename -> (filename.endsWith('.gtf') || filename.equals('versions.yml')) ? null : filename }
        ]

        // Whole-genome inference outruns the process_high default (16h); on SLURM the
        // queue closure routes this to `long`. CPU fallback (no gpu profile) is slower
        // still — raise here if real runs keep hitting the wall.
        time = { 48.h * task.attempt }
    }
}

// Overwriting publish mode for isotools fusion
process {
    withName: /.*:ISOTOOLS_FUSION.*/ {
        publishDir = [
            path: { "${params.output_dir}/10_final/fusions" },
